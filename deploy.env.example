# Copy to .deploy.env and fill in your real values. .deploy.env is git-ignored —
# never commit it. ./deploy auto-sources it, so these never need exporting by
# hand each session. See homelab/README.md for the contract these names follow.

# ssh destination for the NAS host itself. (Was TARGET_USER + TARGET_HOST +
# SSH_PORT; renamed to match the three sibling projects.)
NAS_SSH=deploy@nas.local
NAS_SSH_PORT=22

# No per-instance APP_LAN_IP_<INSTANCE> here any more — neither instance has
# a LAN address of its own. Both join homelab-internal (a plain bridge shared
# with Traefik) and are reached only through Traefik's
# security-digest.servers.zou / news-digest.servers.zou routes. See
# homelab-auth/README.md for the central-login project this is part of.

# Optional.
# BUILD_ON=mac                 # or nas — same as --build-on
# NAS_APP_DIR=/share/Container # parent of the per-instance directories
# NAS_BUILD_DIR=/share/Container/security-digest-build   # --build-on nas only
# NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
# NAS_PLATFORM=linux/amd64
