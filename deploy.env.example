# Copy to .deploy.env and fill in your real values. .deploy.env is
# git-ignored — never commit it. deploy.sh and deploy-native.sh auto-source
# it if present, so these never need to be exported by hand each session.

# ssh destination for the NAS.
TARGET_USER=deploy
TARGET_HOST=nas.local
SSH_PORT=22

# Static qnet IPs for the two Container Station-managed containers (see
# container-station-app.yaml). Used only by `./deploy.sh --render-station`
# to produce deploy-out/container-station-app.yaml with your real addresses
# filled in — paste that rendered file into Container Station, not the
# tracked template.
STATION_IP_SECURITY=10.0.0.2
STATION_IP_NEWS=10.0.0.3
