# LLM provider key (for summarisation) — set the one matching llm.provider.
# Only open-weight models are supported: Mistral or OpenRouter.
MISTRAL_API_KEY=
# OpenRouter routes to many vendors behind one key and one OpenAI-compatible
# endpoint; its model ids look like vendor/model (e.g. google/gemini-2.5-flash).
OPENROUTER_API_KEY=

# Email delivery (when delivery.output: email)
# Addresses live here rather than in config.yaml: config.yaml is committed and
# is pushed over the target's copy on every deploy, so an address there is both
# published and overwritten. This file is neither. Both override config.yaml's
# delivery.email.from/to; a digest's own `to:` still wins for that digest.
DIGEST_EMAIL_FROM=your-email@gmail.com
DIGEST_EMAIL_TO=your-email@gmail.com
# Comma-separate for several recipients: DIGEST_EMAIL_TO=a@x.com,b@y.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Obsidian vault projection (when vault.enabled: true in config.yaml).
#
# This is the CouchDB your VAULT replicates against via Self-hosted LiveSync --
# not this app's own storage, which is SQLite and needs nothing here. The
# address lives in this file rather than in config.yaml for the same reason the
# email addresses do: config.yaml is committed and is pushed over the target's
# copy on every deploy.
#
# The account needs member access to the vault database (see README, "Obsidian
# vault"). LiveSync's end-to-end encryption and path obfuscation must both be
# OFF -- we write plaintext chunks keyed by path, and either setting silently
# stops the projection matching what the clients read.
VAULT_COUCHDB_URL=http://couchdb.local:5984
VAULT_COUCHDB_PASSWORD=
