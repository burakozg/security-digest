# LLM provider key (for summarisation) — set the one matching llm.provider
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# OpenRouter routes to many vendors behind one key and one OpenAI-compatible
# endpoint; its model ids look like vendor/model (e.g. google/gemini-2.5-flash).
OPENROUTER_API_KEY=

# Email delivery (when delivery.output: email)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Admin panel access — required to use /admin/* endpoints and POST /run.
# Generate with: openssl rand -hex 32
# Without this set, admin actions are disabled (fail closed).
DIGEST_ADMIN_TOKEN=
